<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ titulo }}</title>
  {# Chart.js cargado localmente desde docs/assets/ — sin CDN #}
  <script src="assets/chart.v4.min.js"></script>
  <style>
    /* ── Variables de diseño ─────────────────────────────────────────────────
       Modificar estos valores cambia la paleta de todo el dashboard.
       --bg: fondo de página | --card: fondo de tarjetas | --header-bg: encabezado
       --accent: números KPI | --text: texto principal | --muted: texto secundario */
    :root {
      --bg:        #f0f2f5;
      --card:      #ffffff;
      --header-bg: #1a2535;
      --accent:    #0072B2;
      --text:      #2c3e50;
      --muted:     #7f8c8d;
      --border:    #e8ecef;
      --radius:    8px;
    }

    /* ── Reset y base ─────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 15px;
      line-height: 1.5;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Contenedor centrado ─────────────────────────────────────────────── */
    .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

    /* ── Encabezado ─────────────────────────────────────────────────────── */
    header { background: var(--header-bg); color: white; padding: 1.75rem 0; }
    header h1 { font-size: 1.4rem; font-weight: 700; }
    header p  { font-size: .9rem; opacity: .7; margin-top: .3rem; }
    .header-meta { font-size: .78rem; opacity: .5; margin-top: .6rem; }

    /* ── KPI cards ───────────────────────────────────────────────────────── */
    .kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }
    .kpi { background: var(--card); border-radius: var(--radius); padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,.07); }
    .kpi-value { font-size: 2rem; font-weight: 700; color: var(--accent); line-height: 1; }
    .kpi-label { font-size: .82rem; color: var(--muted); margin-top: .35rem; }
    .kpi-sub   { font-size: .8rem;  color: var(--text);  margin-top: .2rem; font-weight: 500; }

    /* ── Sección genérica (tarjeta blanca) ───────────────────────────────── */
    .section {
      background: var(--card);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07);
      margin-bottom: 1.25rem;
    }
    .section-title {
      font-size: .77rem; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: .07em; margin-bottom: 1.25rem;
    }

    /* ── Dos columnas ────────────────────────────────────────────────────── */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
    @media (max-width: 680px) { .two-col { grid-template-columns: 1fr; } }

    /* ── Barras horizontales ─────────────────────────────────────────────── */
    .hbar         { display: flex; align-items: center; gap: .75rem; margin-bottom: .65rem; }
    .hbar-label   { width: 115px; font-size: .83rem; text-align: right; flex-shrink: 0; }
    .hbar-track   { flex: 1; background: var(--bg); border-radius: 4px; height: 20px; overflow: hidden; }
    .hbar-fill    { height: 100%; border-radius: 4px; }
    .hbar-value   { width: 65px; font-size: .8rem; color: var(--muted); text-align: right; flex-shrink: 0; }

    /* ── Small multiples (mini-gráficos por palabra) ─────────────────────── */
    .sm-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 680px) { .sm-grid { grid-template-columns: repeat(2, 1fr); } }
    .sm-card { background: #f8f9fb; border-radius: 6px; padding: .6rem; }
    .sm-label { font-size: .76rem; font-weight: 700; margin-bottom: .3rem; }
    .sm-meta  { font-size: .68rem; color: var(--muted); margin-top: .2rem; display: flex; justify-content: space-between; }

    /* ── Mapa SVG ────────────────────────────────────────────────────────── */
    .mapa-wrap { overflow-x: auto; }
    #mapa-tooltip {
      display: none;
      position: fixed;
      background: rgba(26, 37, 53, .9);
      color: white;
      padding: .5rem .75rem;
      border-radius: 6px;
      font-size: .8rem;
      line-height: 1.5;
      pointer-events: none;
      z-index: 100;
      max-width: 200px;
    }
    .provincia-path { transition: fill .15s; }
    .provincia-path:hover { fill: #cdd3db; }
    .provincia-circle { transition: opacity .15s; }
    .provincia-circle:hover { opacity: 1 !important; }

    /* ── Filtros y tabla ─────────────────────────────────────────────────── */
    .filters { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1rem; align-items: center; }
    .filters select,
    .filters input[type=text] {
      border: 1px solid var(--border); border-radius: 6px;
      padding: .4rem .7rem; font-size: .83rem; color: var(--text); background: var(--card);
    }
    .filters input[type=text] { min-width: 170px; }
    #tabla-count { font-size: .82rem; color: var(--muted); margin-left: auto; }
    .tabla-wrap  { overflow-x: auto; }
    table   { width: 100%; border-collapse: collapse; font-size: .82rem; }
    th { text-align: left; padding: .55rem .75rem; background: var(--bg); color: var(--muted); font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid var(--border); white-space: nowrap; }
    td { padding: .55rem .75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:hover td { background: #f8f9fb; }
    .col-semana  { white-space: nowrap; color: var(--muted); }
    .col-titular { max-width: 360px; }

    /* ── Badges de palabras clave ────────────────────────────────────────── */
    .badge { display: inline-block; padding: .15rem .45rem; border-radius: 4px; font-size: .72rem; font-weight: 600; margin: .1rem .1rem .1rem 0; color: white; }

    /* ── Nota metodológica ───────────────────────────────────────────────── */
    .nota { font-size: .79rem; color: var(--muted); background: #f8f9fb; border-left: 3px solid var(--border); padding: .5rem .75rem; border-radius: 0 4px 4px 0; margin-top: 1rem; }

    /* ── Footer ─────────────────────────────────────────────────────────── */
    footer { text-align: center; padding: 2rem 1rem; font-size: .79rem; color: var(--muted); }
    footer a { color: var(--muted); }
  </style>
</head>

<body>

{# ── Encabezado: título, descripción y fecha de actualización ────────────── #}
<header>
  <div class="container">
    <h1>{{ titulo }}</h1>
    <p>{{ subtitulo }}</p>
    <div class="header-meta">
      Última actualización: {{ fecha_generacion }}
      &nbsp;·&nbsp;
      {{ semanas_cubiertas }} semana{% if semanas_cubiertas != 1 %}s{% endif %} de datos
    </div>
  </div>
</header>

<main class="container">

  {# ── KPIs: cuatro métricas resumen ─────────────────────────────────────── #}
  <div class="kpis">

    <div class="kpi">
      <div class="kpi-value">{{ total_menciones }}</div>
      <div class="kpi-label">Menciones totales</div>
      <div class="kpi-sub">en {{ semanas_cubiertas }} semana{% if semanas_cubiertas != 1 %}s{% endif %}</div>
    </div>

    <div class="kpi">
      <div class="kpi-value">{{ semanas_cubiertas }}</div>
      <div class="kpi-label">Semanas cubiertas</div>
      <div class="kpi-sub">hasta {{ ultima_semana }}</div>
    </div>

    <div class="kpi">
      <div class="kpi-value" style="color: {{ colores.get(palabra_top, color_fallback) }}">{{ palabra_top_count }}</div>
      <div class="kpi-label">Menciones de &ldquo;{{ palabra_top }}&rdquo;</div>
      <div class="kpi-sub">palabra más frecuente</div>
    </div>

    <div class="kpi">
      <div class="kpi-value">{{ region_top_count }}</div>
      <div class="kpi-label">Menciones en {{ region_top }}</div>
      <div class="kpi-sub">región más activa (corpus provincial)</div>
    </div>

  </div>

  {# ── A: TENDENCIA SEMANAL — línea Chart.js ─────────────────────────────── #}
  {# Es la visualización principal: ¿sube o baja el conflicto?               #}
  {# Con 2 puntos se ve el punto de partida y la primera variación.           #}
  <div class="section">
    <div class="section-title">Tendencia semanal — total de menciones</div>
    <canvas id="chart-tendencia" height="100"></canvas>
    <p class="nota">
      Menciones absolutas (titulares con ≥1 palabra clave).
      {% if semanas_cubiertas < 4 %}La tendencia se consolida a partir de la semana 6.{% endif %}
    </p>
  </div>

  {# ── B: SMALL MULTIPLES — 8 mini-gráficos SVG (misma escala Y) ─────────── #}
  {# Permite comparar qué palabra sube y cuál baja sin que se tapen entre sí. #}
  {# SVG puro generado por Jinja2; no usa Chart.js ni ninguna otra librería.  #}
  <div class="section">
    <div class="section-title">Evolución por palabra clave (misma escala)</div>
    <div class="sm-grid">
      {% for sm in small_multiples %}
      <div class="sm-card">
        <div class="sm-label" style="color: {{ sm.color }}">{{ sm.palabra }}</div>
        <svg viewBox="0 0 {{ mini_w }} {{ mini_h }}"
             style="width:100%; display:block; overflow:visible;">
          {# Fondo #}
          <rect width="{{ mini_w }}" height="{{ mini_h }}" fill="white" rx="3"/>
          {# Línea base #}
          <line x1="{{ mini_pad }}" y1="{{ mini_h - mini_pad }}"
                x2="{{ mini_w - mini_pad }}" y2="{{ mini_h - mini_pad }}"
                stroke="#e8ecef" stroke-width="1"/>
          {% if sm.puntos | length >= 2 %}
          {# Área bajo la curva #}
          <polygon
            points="{{ sm.puntos[0][0] }},{{ mini_h - mini_pad }} {% for px, py in sm.puntos %}{{ px }},{{ py }} {% endfor %}{{ sm.puntos[-1][0] }},{{ mini_h - mini_pad }}"
            fill="{{ sm.color }}" opacity="0.12"/>
          {# Línea de la serie #}
          <polyline
            points="{% for px, py in sm.puntos %}{{ px }},{{ py }} {% endfor %}"
            fill="none" stroke="{{ sm.color }}" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"/>
          {# Puntos de datos #}
          {% for px, py in sm.puntos %}
          <circle cx="{{ px }}" cy="{{ py }}" r="3.5"
                  fill="{{ sm.color }}" stroke="white" stroke-width="1.5"/>
          {% endfor %}
          {% elif sm.puntos | length == 1 %}
          {# Un solo punto #}
          {% set px, py = sm.puntos[0] %}
          <circle cx="{{ px }}" cy="{{ py }}" r="4"
                  fill="{{ sm.color }}" stroke="white" stroke-width="1.5"/>
          {% endif %}
        </svg>
        <div class="sm-meta">
          {% for sc in semanas_cortas %}
          <span>{{ sc }}</span>
          {% endfor %}
          <span style="margin-left:auto">máx {{ sm.max_val }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
    <p class="nota">
      Todos los mini-gráficos comparten la misma escala Y (máximo: {{ small_multiples | map(attribute='max_val') | max }}).
      La comparación visual es directa: una barra más alta en un gráfico significa más menciones que en otro.
    </p>
  </div>

  {# ── C: STREAMGRAPH (comentado — activar con >= 6 meses de datos) ──────── #}
  {# Requiere D3 v7. Cuando llegue el momento, correr descargar_assets.py     #}
  {# para que también descargue d3.v7.min.js y agregar el <script> en <head>. #}
  <!-- # ACTIVAR con >= 6 meses de datos
  <div class="section">
    <div class="section-title">Flujo de conflictividad (streamgraph)</div>
    <div id="streamgraph" style="width:100%; height:200px;"></div>
    <script>
      // Streamgraph D3 v7: muestra el flujo y mezcla de palabras en el tiempo.
      // Los datos están disponibles como composicion_datasets en el contexto.
      // Implementar aquí con d3.stack() cuando haya suficientes semanas.
    </script>
  </div>
  -->

  {# ── Distribución por palabra y por región (barras horizontales) ─────────── #}
  <div class="two-col">

    <div class="section" style="margin-bottom:0">
      <div class="section-title">Menciones por palabra clave</div>
      {% for item in dist_palabras %}
      <div class="hbar">
        <div class="hbar-label">{{ item.palabra }}</div>
        <div class="hbar-track">
          <div class="hbar-fill"
               style="width:{{ ((item.total / max_palabra) * 100)|int }}%;background:{{ item.color }}">
          </div>
        </div>
        <div class="hbar-value">
          {{ item.total }}<small style="opacity:.6">&nbsp;{{ item.porcentaje }}%</small>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="section" style="margin-bottom:0">
      <div class="section-title">Menciones por región (corpus provincial)</div>
      {% if dist_regiones %}
        {% for item in dist_regiones %}
        <div class="hbar">
          <div class="hbar-label">{{ item.region }}</div>
          <div class="hbar-track">
            <div class="hbar-fill"
                 style="width:{{ ((item.total / max_region) * 100)|int }}%;background:{{ color_region }}">
            </div>
          </div>
          <div class="hbar-value">{{ item.total }}</div>
        </div>
        {% endfor %}
        {% if total_nacional > 0 %}
        <p class="nota">Corpus nacional: {{ total_nacional }} menciones (excluidas del gráfico).</p>
        {% endif %}
      {% else %}
        <p class="nota">Sin datos provinciales disponibles.</p>
      {% endif %}
    </div>

  </div>

  {# ── D: MAPA SVG — símbolos proporcionales por provincia ─────────────────── #}
  {# Las formas de las provincias son paths SVG horneados en Python.           #}
  {# No se carga ninguna librería de mapas: interactividad con vanilla JS.     #}
  <div class="section">
    <div class="section-title">Mapa de conflictividad por provincia (corpus provincial)</div>
    <div class="mapa-wrap">
      {% if provincias_mapa %}
      <svg width="{{ mapa_ancho }}" height="{{ mapa_alto }}"
           viewBox="0 0 {{ mapa_ancho }} {{ mapa_alto }}"
           style="display:block; margin:0 auto; max-width:100%;">

        {# Fondo del mapa #}
        <rect width="{{ mapa_ancho }}" height="{{ mapa_alto }}" fill="#f0f4f8" rx="8"/>

        {# Formas de las provincias (paths geográficos) #}
        {% for p in provincias_mapa %}
        <path d="{{ p.path_d }}"
              fill="#dde3ea" stroke="white" stroke-width="0.7" stroke-linejoin="round"
              class="provincia-path"/>
        {% endfor %}

        {# Círculos proporcionales (uno por provincia, sobre el centroide) #}
        {% for p in provincias_mapa %}
        <circle
          cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.radio }}"
          fill="{{ p.color }}"
          opacity="{{ '0.3' if p.sin_datos else '0.82' }}"
          stroke="white" stroke-width="{{ '0.5' if p.sin_datos else '1.2' }}"
          class="provincia-circle"
          data-nombre="{{ p.nombre }}"
          data-menciones="{{ p.menciones }}"
          data-palabra="{{ p.palabra_dominante }}"
          data-sin-datos="{{ 'true' if p.sin_datos else 'false' }}"
          style="cursor:pointer"/>
        {% endfor %}

      </svg>
      {% else %}
      <p class="nota">
        Mapa no disponible. Corré: <code>python tools/descargar_assets.py</code>
      </p>
      {% endif %}
    </div>
    <p class="nota">
      Círculos proporcionales: radio = √menciones. Color = palabra clave dominante en la provincia.
      Gris = sin menciones esta semana.
      Cada provincia tiene igual peso en el corpus (3 medios). CABA no tiene medios en el corpus provincial.
      Los datos representan eco mediático (menciones en titulares), no eventos verificados.
    </p>
  </div>

  {# ── F: COMPOSICIÓN DEL CONFLICTO — barra apilada Chart.js ─────────────── #}
  {# Muestra no solo cuánto conflicto hay, sino de qué tipo en cada semana.   #}
  <div class="section">
    <div class="section-title">Composición del conflicto por semana</div>
    <canvas id="chart-composicion" height="140"></canvas>
    <p class="nota">
      Un titular con múltiples palabras (ej. &ldquo;paro y marcha&rdquo;) suma +1 a cada palabra por separado.
      La suma total de la barra puede superar el total de titulares (ver METODOLOGIA.md §8.5).
    </p>
  </div>

  {# ── G: TABLA DE TITULARES (sin cambios respecto a la versión anterior) ─── #}
  <div class="section">
    <div class="section-title">Titulares detectados</div>

    <div class="filters">
      <select id="f-corpus" onchange="filtrar()">
        <option value="">Todos los corpus</option>
        {% for c in corpus_opciones %}
        <option value="{{ c }}">{{ c | capitalize }}</option>
        {% endfor %}
      </select>

      <select id="f-region" onchange="filtrar()">
        <option value="">Todas las regiones</option>
        {% for r in regiones_opciones %}
        <option value="{{ r }}">{{ r }}</option>
        {% endfor %}
      </select>

      <select id="f-palabra" onchange="filtrar()">
        <option value="">Todas las palabras</option>
        {% for p in palabras_opciones %}
        <option value="{{ p }}">{{ p }}</option>
        {% endfor %}
      </select>

      <select id="f-semana" onchange="filtrar()">
        <option value="">Todas las semanas</option>
        {% for s in semanas_opciones %}
        <option value="{{ s }}">{{ s }}</option>
        {% endfor %}
      </select>

      <input type="text" id="f-texto" placeholder="Buscar en titular…" oninput="filtrar()">
      <span id="tabla-count">{{ filas_tabla | length }} titulares</span>
    </div>

    <div class="tabla-wrap">
      <table>
        <thead>
          <tr>
            <th>Semana</th><th>Corpus</th><th>Diario</th>
            <th>Región</th><th>Titular</th><th>Palabras</th>
          </tr>
        </thead>
        <tbody id="tabla-body">
          {% for fila in filas_tabla %}
          <tr
            data-corpus="{{ fila.corpus }}"
            data-region="{{ fila.region }}"
            data-semana="{{ fila.semana_iso }}"
            data-palabras="{{ fila.palabras_encontradas }}"
            data-titular="{{ fila.titular | lower }}">
            <td class="col-semana">{{ fila.semana_iso.split('-')[1] }}</td>
            <td>{{ fila.corpus }}</td>
            <td>{{ fila.diario }}</td>
            <td>{{ fila.region }}</td>
            <td class="col-titular">{{ fila.titular }}</td>
            <td>
              {% for p in fila.palabras_encontradas.split(', ') %}
              <span class="badge" style="background:{{ colores.get(p.strip(), color_fallback) }}">{{ p.strip() }}</span>
              {% endfor %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</main>

<footer>
  <p>Monitor de Conflictividad Social · Argentina</p>
  <p style="margin-top:.3rem">
    Datos, metodología y código en
    <a href="https://github.com/Flormena/monitor-conflictos" target="_blank">GitHub</a>
    &nbsp;·&nbsp; Generado el {{ fecha_generacion }}
  </p>
</footer>

{# Tooltip del mapa: div posicionado con JS #}
<div id="mapa-tooltip"></div>

<script>
// ── Gráfico A: línea de tendencia semanal (Chart.js) ─────────────────────────
// Visualización principal: total de menciones por semana.
new Chart(document.getElementById('chart-tendencia').getContext('2d'), {
  type: 'line',
  data: {
    labels: {{ semanas_cortas | tojson | safe }},
    datasets: [{
      label: 'Menciones totales',
      data:  {{ total_por_semana | tojson | safe }},
      borderColor:       '#0072B2',
      backgroundColor:   'rgba(0, 114, 178, 0.08)',
      borderWidth:       2.5,
      pointRadius:       6,
      pointHoverRadius:  8,
      pointBackgroundColor: '#0072B2',
      tension: 0.0,
      fill: true,
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: {
      y: { beginAtZero: true, ticks: { precision: 0 } }
    }
  }
});

// ── Gráfico F: composición del conflicto (Chart.js stacked bar) ──────────────
// Una columna por semana, segmentos coloreados = palabras clave.
new Chart(document.getElementById('chart-composicion').getContext('2d'), {
  type: 'bar',
  data: {
    labels: {{ semanas_cortas | tojson | safe }},
    datasets: [
      {% for ds in composicion_datasets %}
      {
        label:           {{ ds.label | tojson | safe }},
        data:            {{ ds.data  | tojson | safe }},
        backgroundColor: {{ ds.color | tojson | safe }},
        stack: 'composicion',
      },
      {% endfor %}
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } },
    },
    scales: {
      x: { stacked: true },
      y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } }
    }
  }
});

// ── Tooltip del mapa SVG (vanilla JS) ────────────────────────────────────────
// Al pasar el mouse por un círculo se muestra el nombre, menciones y palabra dominante.
var mapaTooltip = document.getElementById('mapa-tooltip');
document.querySelectorAll('.provincia-circle').forEach(function(c) {
  c.addEventListener('mousemove', function(e) {
    var sinDatos = this.dataset.sinDatos === 'true';
    var html = '<strong>' + this.dataset.nombre + '</strong><br>';
    html += sinDatos
      ? 'Sin menciones'
      : this.dataset.menciones + ' menciones<br>Dominante: <strong>' + this.dataset.palabra + '</strong>';
    mapaTooltip.innerHTML = html;
    mapaTooltip.style.display = 'block';
    mapaTooltip.style.left = (e.clientX + 14) + 'px';
    mapaTooltip.style.top  = (e.clientY - 10) + 'px';
  });
  c.addEventListener('mouseleave', function() {
    mapaTooltip.style.display = 'none';
  });
});

// ── Filtrado de la tabla (vanilla JS) ────────────────────────────────────────
// Lee data-attributes de cada fila y muestra/oculta según los filtros activos.
function filtrar() {
  var corpus  = document.getElementById('f-corpus').value;
  var region  = document.getElementById('f-region').value;
  var palabra = document.getElementById('f-palabra').value;
  var semana  = document.getElementById('f-semana').value;
  var texto   = document.getElementById('f-texto').value.toLowerCase().trim();

  var filas = document.querySelectorAll('#tabla-body tr');
  var visibles = 0;
  filas.forEach(function(tr) {
    var ok = true;
    if (corpus  && tr.dataset.corpus  !== corpus)  ok = false;
    if (region  && tr.dataset.region  !== region)  ok = false;
    if (semana  && tr.dataset.semana  !== semana)  ok = false;
    if (palabra) {
      var ps = tr.dataset.palabras.split(',').map(function(p){ return p.trim(); });
      if (ps.indexOf(palabra) === -1) ok = false;
    }
    if (texto && tr.dataset.titular.indexOf(texto) === -1) ok = false;
    tr.style.display = ok ? '' : 'none';
    if (ok) visibles++;
  });
  document.getElementById('tabla-count').textContent =
    visibles + ' titular' + (visibles !== 1 ? 'es' : '');
}
</script>

</body>
</html>
