<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ titulo }}</title>
  {# Chart.js cargado localmente desde docs/assets/ — sin CDN #}
  <script src="assets/chart.v4.min.js"></script>
  <style>
    /* ── Sistema de diseño ───────────────────────────────────────────────────
       Paleta editorial: texto/superficies en escala de grises azulados, con un
       acento propio (--accent) DISTINTO de la paleta de datos (Okabe-Ito), para
       que el lector nunca confunda "color de marca" con "color de palabra clave".
       Modificar estas variables cambia el aspecto de todo el dashboard. */
    :root {
      --ink:        #14171f;
      --ink-2:      #475467;
      --ink-3:      #98a2b3;
      --bg:         #f7f8fa;
      --surface:    #ffffff;
      --surface-2:  #f0f2f5;
      --border:     #e4e7ec;
      --accent:     #1d4e89;
      --accent-bg:  #eaf1fb;
      --header-bg:  #0b1220;
      --header-ink: #f7f8fa;
      --header-ink-2: #8a93a6;
      --radius: 6px;
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--ink);
      font-size: 15px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      background: var(--surface-2); padding: .1rem .35rem; border-radius: 4px;
      font-size: .85em;
    }

    .container { max-width: 1180px; margin: 0 auto; padding: 0 1.5rem; }

    /* ── Encabezado editorial ────────────────────────────────────────────── */
    header.hero {
      background: var(--header-bg);
      color: var(--header-ink);
      padding: 3rem 0 0;
    }
    .eyebrow {
      font-size: .72rem; font-weight: 700; letter-spacing: .12em;
      text-transform: uppercase; color: #6e9bd6; margin-bottom: .6rem;
    }
    header.hero h1 { font-size: 1.9rem; font-weight: 800; letter-spacing: -.01em; max-width: 760px; }
    header.hero p.lede { font-size: 1.02rem; color: var(--header-ink-2); margin-top: .6rem; max-width: 620px; }
    .header-meta {
      font-size: .78rem; color: var(--header-ink-2); margin-top: 1.1rem;
      padding-bottom: 1.6rem; border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .header-meta strong { color: var(--header-ink); font-weight: 600; }

    /* ── Franja de KPIs (parte del header, fondo oscuro) ───────────────────── */
    .kpi-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 1px;
      background: rgba(255,255,255,.08);
    }
    .kpi {
      background: var(--header-bg);
      padding: 1.4rem 1.6rem;
    }
    .kpi-value-row { display: flex; align-items: baseline; gap: .5rem; }
    .kpi-value { font-size: 2.1rem; font-weight: 800; color: var(--header-ink); line-height: 1; letter-spacing: -.02em; }
    .kpi-trend { font-size: .78rem; font-weight: 700; padding: .15rem .4rem; border-radius: 4px; }
    .kpi-trend.alza    { background: rgba(204,0,0,.18);  color: #ff8a8a; }
    .kpi-trend.baja    { background: rgba(0,158,115,.18); color: #5fe3bd; }
    .kpi-trend.estable { background: rgba(255,255,255,.1); color: var(--header-ink-2); }
    .kpi-label { font-size: .82rem; color: var(--header-ink-2); margin-top: .4rem; }
    .kpi-sub   { font-size: .76rem; color: #5f6b80; margin-top: .15rem; }

    /* ── Resumen automático (oración de contexto bajo el header) ───────────── */
    .resumen-banda {
      background: var(--accent-bg);
      border-bottom: 1px solid var(--border);
      padding: 1rem 0;
    }
    .resumen-banda p {
      font-size: .94rem; color: var(--ink); max-width: 900px;
    }
    .resumen-banda p::before { content: "▸ "; color: var(--accent); font-weight: 700; }

    /* ── Secciones numeradas (estructura de informe) ────────────────────────── */
    main { padding: 2.5rem 0 1rem; }
    section.bloque { margin-bottom: 3rem; }
    .bloque-head { display: flex; align-items: baseline; gap: .75rem; margin-bottom: 1.25rem; }
    .bloque-num {
      font-size: .78rem; font-weight: 800; color: var(--accent);
      background: var(--accent-bg); border-radius: 4px; padding: .15rem .5rem;
      letter-spacing: .03em;
    }
    .bloque-head h2 { font-size: 1.15rem; font-weight: 700; color: var(--ink); }
    .bloque-desc { font-size: .87rem; color: var(--ink-2); margin: -.5rem 0 1.25rem; max-width: 760px; }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
    }
    .grid-2 { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.25rem; }
    .grid-2-rev { display: grid; grid-template-columns: 1fr 1.3fr; gap: 1.25rem; }
    @media (max-width: 820px) {
      .grid-2, .grid-2-rev { grid-template-columns: 1fr; }
    }

    .nota {
      font-size: .81rem; color: var(--ink-3); margin-top: 1rem;
      padding-top: .9rem; border-top: 1px solid var(--border);
    }

    /* ── Small multiples ─────────────────────────────────────────────────── */
    .sm-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .9rem; margin-top: 1.25rem; }
    @media (max-width: 820px) { .sm-grid { grid-template-columns: repeat(2, 1fr); } }
    .sm-card { background: var(--surface-2); border-radius: 6px; padding: .7rem .8rem; }
    .sm-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .35rem; }
    .sm-label { font-size: .76rem; font-weight: 700; }
    .sm-total { font-size: .76rem; color: var(--ink-3); }
    .sm-meta { display: flex; justify-content: space-between; font-size: .66rem; color: var(--ink-3); margin-top: .25rem; }

    /* ── Ranking de palabras / provincias (listas con barra) ────────────────── */
    .ranking-row {
      display: grid; grid-template-columns: 1.6rem 6.5rem 1fr 3rem;
      align-items: center; gap: .6rem; padding: .42rem 0;
    }
    .ranking-pos { font-size: .76rem; color: var(--ink-3); font-weight: 700; }
    .ranking-label { font-size: .84rem; font-weight: 600; }
    .ranking-track { background: var(--surface-2); border-radius: 3px; height: 10px; overflow: hidden; }
    .ranking-fill { height: 100%; border-radius: 3px; }
    .ranking-value { font-size: .8rem; color: var(--ink-2); text-align: right; }
    .ranking-row.clicable { cursor: pointer; border-radius: 4px; transition: background .12s; }
    .ranking-row.clicable:hover { background: var(--surface-2); }
    .ranking-row.activo { background: var(--accent-bg); }

    /* ── Mapa SVG ────────────────────────────────────────────────────────── */
    .mapa-wrap { overflow: visible; text-align: center; }
    #mapa-tooltip {
      display: none; position: fixed; background: var(--ink); color: white;
      padding: .55rem .8rem; border-radius: 6px; font-size: .8rem; line-height: 1.5;
      pointer-events: none; z-index: 100; max-width: 210px; box-shadow: 0 4px 16px rgba(0,0,0,.25);
    }
    .provincia-path { transition: fill .15s; }
    .provincia-path:hover { fill: #cdd3db; }
    .provincia-circle { transition: opacity .15s, stroke-width .15s; }
    .provincia-circle:hover { opacity: 1 !important; }
    .provincia-circle.selected { stroke: var(--accent); stroke-width: 2.5; opacity: 1 !important; }

    .chip {
      display: none; align-items: center; gap: .4rem;
      background: var(--accent-bg); color: var(--accent); border: 1px solid #c3d9f3;
      border-radius: 999px; padding: .3rem .7rem; font-size: .78rem; font-weight: 600;
      margin-bottom: .9rem;
    }
    .chip button {
      background: none; border: none; color: var(--accent); font-size: 1rem;
      cursor: pointer; line-height: 1; padding: 0;
    }

    /* ── Filtros y tabla ─────────────────────────────────────────────────── */
    .filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1rem; align-items: center; }
    .filters select, .filters input[type=text] {
      border: 1px solid var(--border); border-radius: 6px;
      padding: .42rem .7rem; font-size: .82rem; color: var(--ink); background: var(--surface);
    }
    .filters select:focus, .filters input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .filters input[type=text] { min-width: 190px; }
    #tabla-count { font-size: .8rem; color: var(--ink-3); margin-left: auto; }
    .tabla-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .81rem; }
    th {
      text-align: left; padding: .55rem .7rem; background: var(--surface-2); color: var(--ink-2);
      font-size: .73rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
      border-bottom: 2px solid var(--border); white-space: nowrap;
    }
    td { padding: .55rem .7rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:hover td { background: var(--surface-2); }
    .col-semana { white-space: nowrap; color: var(--ink-3); }
    .col-titular { max-width: 360px; }
    .badge {
      display: inline-block; padding: .14rem .42rem; border-radius: 4px;
      font-size: .7rem; font-weight: 700; margin: .08rem .08rem .08rem 0; color: white;
    }

    /* ── Metodología (sección de transparencia) ─────────────────────────── */
    .metodologia-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    @media (max-width: 820px) { .metodologia-grid { grid-template-columns: 1fr; } }
    .metodologia-grid h3 { font-size: .85rem; font-weight: 700; margin-bottom: .5rem; }
    .metodologia-grid ul { padding-left: 1.1rem; font-size: .83rem; color: var(--ink-2); }
    .metodologia-grid li { margin-bottom: .35rem; }

    footer { text-align: center; padding: 2.5rem 1rem 3rem; font-size: .79rem; color: var(--ink-3); }
    footer a { color: var(--ink-3); }
  </style>
</head>

<body>

{# ── Encabezado: identidad editorial + KPIs con tendencia ─────────────────── #}
<header class="hero">
  <div class="container">
    <div class="eyebrow">Monitor de conflictividad social</div>
    <h1>{{ titulo }}</h1>
    <p class="lede">{{ subtitulo }}</p>
    <div class="header-meta">
      Última actualización: <strong>{{ fecha_generacion }}</strong>
      &nbsp;·&nbsp; {{ semanas_cubiertas }} semana{% if semanas_cubiertas != 1 %}s{% endif %} de datos
      &nbsp;·&nbsp; hasta <strong>{{ ultima_semana }}</strong>
    </div>
  </div>

  <div class="kpi-strip">
    <div class="kpi">
      <div class="kpi-value-row">
        <span class="kpi-value">{{ total_menciones }}</span>
        {% if tendencia.direccion %}
        <span class="kpi-trend {{ tendencia.direccion }}">
          {% if tendencia.direccion == 'alza' %}▲{% elif tendencia.direccion == 'baja' %}▼{% else %}—{% endif %}
          {{ tendencia.pct }}%
        </span>
        {% endif %}
      </div>
      <div class="kpi-label">Menciones totales</div>
      <div class="kpi-sub">vs. semana anterior</div>
    </div>

    <div class="kpi">
      <div class="kpi-value">{{ semanas_cubiertas }}</div>
      <div class="kpi-label">Semanas cubiertas</div>
      <div class="kpi-sub">acumulado histórico</div>
    </div>

    <div class="kpi">
      <div class="kpi-value" style="color: {{ colores.get(palabra_top, color_fallback) }}">{{ palabra_top_count }}</div>
      <div class="kpi-label">&ldquo;{{ palabra_top }}&rdquo;</div>
      <div class="kpi-sub">palabra más frecuente</div>
    </div>

    <div class="kpi">
      <div class="kpi-value">{{ region_top_count }}</div>
      <div class="kpi-label">{{ region_top }}</div>
      <div class="kpi-sub">región más activa (provincial)</div>
    </div>
  </div>
</header>

{# ── Resumen automático: oración de contexto generada desde los datos ─────── #}
<div class="resumen-banda">
  <div class="container">
    <p>{{ resumen_automatico | safe }}</p>
  </div>
</div>

<main class="container">

  {# ── 01: TENDENCIA GENERAL ────────────────────────────────────────────── #}
  <section class="bloque">
    <div class="bloque-head">
      <span class="bloque-num">01</span>
      <h2>Tendencia general</h2>
    </div>
    <p class="bloque-desc">
      Total de menciones por semana en ambos corpus. Es el indicador principal: si sube o baja
      la conflictividad detectada por el monitor.
    </p>
    <div class="panel">
      <canvas id="chart-tendencia" height="90"></canvas>
      <div class="nota">
        Menciones absolutas (titulares con ≥1 palabra clave), sin deduplicar entre medios (METODOLOGIA.md §8.6).
        {% if semanas_cubiertas < 6 %}La tendencia se consolida estadísticamente a partir de la semana 6.{% endif %}
      </div>
    </div>
  </section>

  {# ── 02: COMPOSICIÓN DEL CONFLICTO ────────────────────────────────────── #}
  <section class="bloque">
    <div class="bloque-head">
      <span class="bloque-num">02</span>
      <h2>Composición del conflicto</h2>
    </div>
    <p class="bloque-desc">
      No solo cuánta conflictividad hay, sino de qué tipo: qué palabras dominan cada semana
      y cómo evoluciona cada una por separado, todas en la misma escala para comparar.
    </p>
    <div class="panel">
      <canvas id="chart-composicion" height="120"></canvas>
      <div class="nota">
        Un titular con varias palabras (ej. &ldquo;paro y marcha&rdquo;) suma +1 a cada una.
        La suma de la barra puede superar el total de titulares (METODOLOGIA.md §8.5).
      </div>
    </div>

    <div class="panel" style="margin-top:1.25rem">
      <div style="font-size:.82rem; font-weight:700; color:var(--ink-2); margin-bottom:.25rem;">
        Evolución por palabra (misma escala Y)
      </div>
      <div class="sm-grid">
        {% for sm in small_multiples %}
        <div class="sm-card">
          <div class="sm-top">
            <span class="sm-label" style="color:{{ sm.color }}">{{ sm.palabra }}</span>
            <span class="sm-total">máx {{ sm.max_val }}</span>
          </div>
          <svg viewBox="0 0 {{ mini_w }} {{ mini_h }}" style="width:100%; display:block; overflow:visible;">
            <rect width="{{ mini_w }}" height="{{ mini_h }}" fill="white" rx="3"/>
            <line x1="{{ mini_pad }}" y1="{{ mini_h - mini_pad }}" x2="{{ mini_w - mini_pad }}" y2="{{ mini_h - mini_pad }}" stroke="#e4e7ec" stroke-width="1"/>
            {% if sm.puntos | length >= 2 %}
            <polygon
              points="{{ sm.puntos[0][0] }},{{ mini_h - mini_pad }} {% for px, py in sm.puntos %}{{ px }},{{ py }} {% endfor %}{{ sm.puntos[-1][0] }},{{ mini_h - mini_pad }}"
              fill="{{ sm.color }}" opacity="0.12"/>
            <polyline points="{% for px, py in sm.puntos %}{{ px }},{{ py }} {% endfor %}"
              fill="none" stroke="{{ sm.color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            {% for px, py in sm.puntos %}
            <circle cx="{{ px }}" cy="{{ py }}" r="3.2" fill="{{ sm.color }}" stroke="white" stroke-width="1.3"/>
            {% endfor %}
            {% elif sm.puntos | length == 1 %}
            {% set px, py = sm.puntos[0] %}
            <circle cx="{{ px }}" cy="{{ py }}" r="3.8" fill="{{ sm.color }}" stroke="white" stroke-width="1.3"/>
            {% endif %}
          </svg>
          <div class="sm-meta">
            {% for sc in semanas_cortas %}<span>{{ sc }}</span>{% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── 03: GEOGRAFÍA — mapa y ranking de provincias, vinculados ────────────── #}
  <section class="bloque">
    <div class="bloque-head">
      <span class="bloque-num">03</span>
      <h2>Geografía de la conflictividad</h2>
    </div>
    <p class="bloque-desc">
      Círculos proporcionales por provincia: el tamaño es la cantidad de menciones, el color
      es la palabra dominante. Hacé clic en una provincia (mapa o lista) para filtrar la tabla de titulares.
    </p>
    <div class="grid-2">
      <div class="panel mapa-wrap">
        {% if provincias_mapa %}
        <svg width="{{ mapa_ancho }}" height="{{ mapa_alto }}" viewBox="0 0 {{ mapa_ancho }} {{ mapa_alto }}"
             style="display:block; margin:0 auto; max-width:100%; height:auto;">
          <rect width="{{ mapa_ancho }}" height="{{ mapa_alto }}" fill="#f4f6f9" rx="8"/>
          {% for p in provincias_mapa %}
          <path d="{{ p.path_d }}" fill="#dde3ea" stroke="white" stroke-width="0.7" stroke-linejoin="round" class="provincia-path"/>
          {% endfor %}
          {% for p in provincias_mapa %}
          <circle
            cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.radio }}"
            fill="{{ p.color }}"
            opacity="{{ '0.3' if p.sin_datos else '0.82' }}"
            stroke="white" stroke-width="{{ '0.5' if p.sin_datos else '1.2' }}"
            class="provincia-circle"
            data-nombre="{{ p.nombre }}"
            data-menciones="{{ p.menciones }}"
            data-palabra="{{ p.palabra_dominante }}"
            data-sin-datos="{{ 'true' if p.sin_datos else 'false' }}"
            style="cursor:pointer"/>
          {% endfor %}
        </svg>
        {% else %}
        <p class="nota" style="border-top:none; padding-top:0;">
          Mapa no disponible. Corré: <code>python tools/descargar_assets.py</code>
        </p>
        {% endif %}
      </div>

      <div class="panel">
        <div style="font-size:.82rem; font-weight:700; color:var(--ink-2); margin-bottom:.6rem;">
          Top provincias por menciones
        </div>
        {% if provincias_ranking %}
        {% set max_rank = provincias_ranking[0].menciones %}
        {% for p in provincias_ranking %}
        <div class="ranking-row clicable provincia-rank-row" data-nombre="{{ p.nombre }}">
          <span class="ranking-pos">{{ loop.index }}</span>
          <span class="ranking-label">{{ p.nombre }}</span>
          <div class="ranking-track">
            <div class="ranking-fill" style="width:{{ (p.menciones / max_rank * 100)|int }}%; background:{{ p.color }};"></div>
          </div>
          <span class="ranking-value">{{ p.menciones }}</span>
        </div>
        {% endfor %}
        {% else %}
        <p class="nota" style="border-top:none; padding-top:0;">Sin menciones provinciales todavía.</p>
        {% endif %}
        {% if total_nacional > 0 %}
        <div class="nota">Corpus nacional: {{ total_nacional }} menciones (no incluidas; ver tabla abajo).</div>
        {% endif %}
      </div>
    </div>
    <p class="nota">
      Cada provincia tiene igual peso en el corpus (3 medios). CABA no tiene medios en el corpus provincial.
      Los datos representan eco mediático (menciones en titulares), no eventos verificados.
    </p>
  </section>

  {# ── 04: TITULARES — tabla filtrable, vinculada al mapa ──────────────────── #}
  <section class="bloque">
    <div class="bloque-head">
      <span class="bloque-num">04</span>
      <h2>Titulares detectados</h2>
    </div>
    <div class="panel">

      <div class="chip" id="chip-provincia">
        Provincia: <span></span>
        <button onclick="limpiarProvincia()" aria-label="Quitar filtro de provincia">×</button>
      </div>

      <div class="filters">
        <select id="f-corpus" onchange="filtrar()">
          <option value="">Todos los corpus</option>
          {% for c in corpus_opciones %}<option value="{{ c }}">{{ c | capitalize }}</option>{% endfor %}
        </select>
        <select id="f-region" onchange="filtrar()">
          <option value="">Todas las regiones</option>
          {% for r in regiones_opciones %}<option value="{{ r }}">{{ r }}</option>{% endfor %}
        </select>
        <select id="f-palabra" onchange="filtrar()">
          <option value="">Todas las palabras</option>
          {% for p in palabras_opciones %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
        </select>
        <select id="f-semana" onchange="filtrar()">
          <option value="">Todas las semanas</option>
          {% for s in semanas_opciones %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
        </select>
        <input type="text" id="f-texto" placeholder="Buscar en titular…" oninput="filtrar()">
        <span id="tabla-count">{{ filas_tabla | length }} titulares</span>
      </div>

      <div class="tabla-wrap">
        <table>
          <thead>
            <tr><th>Semana</th><th>Corpus</th><th>Diario</th><th>Provincia</th><th>Región</th><th>Titular</th><th>Palabras</th></tr>
          </thead>
          <tbody id="tabla-body">
            {% for fila in filas_tabla %}
            <tr
              data-corpus="{{ fila.corpus }}"
              data-region="{{ fila.region }}"
              data-provincia="{{ fila.provincia }}"
              data-semana="{{ fila.semana_iso }}"
              data-palabras="{{ fila.palabras_encontradas }}"
              data-titular="{{ fila.titular | lower }}">
              <td class="col-semana">{{ fila.semana_iso.split('-')[1] }}</td>
              <td>{{ fila.corpus }}</td>
              <td>{{ fila.diario }}</td>
              <td>{{ fila.provincia }}</td>
              <td>{{ fila.region }}</td>
              <td class="col-titular">{{ fila.titular }}</td>
              <td>
                {% for p in fila.palabras_encontradas.split(', ') %}
                <span class="badge" style="background:{{ colores.get(p.strip(), color_fallback) }}">{{ p.strip() }}</span>
                {% endfor %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {# ── 05: METODOLOGÍA — transparencia, no marketing ────────────────────────── #}
  <section class="bloque">
    <div class="bloque-head">
      <span class="bloque-num">05</span>
      <h2>Cómo leer estos datos</h2>
    </div>
    <div class="panel metodologia-grid">
      <div>
        <h3>Qué mide</h3>
        <ul>
          <li>Menciones de 8 palabras clave en titulares de medios digitales, no eventos verificados.</li>
          <li>Corpus provincial (3 medios × provincia, igual peso) y nacional (~10 diarios), reportados por separado.</li>
          <li>El mapa y los rankings usan eco mediático: cuántas veces se mencionó, no cuántos conflictos reales hubo.</li>
        </ul>
      </div>
      <div>
        <h3>Limitaciones reconocidas</h3>
        <ul>
          <li>Sesgo de cobertura: conflictos no cubiertos por la prensa local no aparecen.</li>
          <li>Sin deduplicar: un mismo evento cubierto por varios medios cuenta varias veces.</li>
          <li>Falsos positivos lingüísticos conocidos (ej. &ldquo;paro cardíaco&rdquo;); se documentan y filtran cuando son significativos.</li>
        </ul>
      </div>
    </div>
    <p class="nota">
      Metodología completa, decisiones documentadas y datos crudos en el
      <a href="https://github.com/Flormena/monitor-conflictos" target="_blank">repositorio de GitHub</a>.
    </p>
  </section>

</main>

<footer>
  <p>Monitor de Conflictividad Social · Argentina</p>
  <p style="margin-top:.3rem">
    Datos, metodología y código en
    <a href="https://github.com/Flormena/monitor-conflictos" target="_blank">GitHub</a>
    &nbsp;·&nbsp; Generado el {{ fecha_generacion }}
  </p>
</footer>

<div id="mapa-tooltip"></div>

<script>
// ── Gráfico 01: tendencia general (Chart.js) ──────────────────────────────────
new Chart(document.getElementById('chart-tendencia').getContext('2d'), {
  type: 'line',
  data: {
    labels: {{ semanas_cortas | tojson | safe }},
    datasets: [{
      data: {{ total_por_semana | tojson | safe }},
      borderColor: '#1d4e89',
      backgroundColor: 'rgba(29,78,137,0.07)',
      borderWidth: 2.5,
      pointRadius: 5,
      pointHoverRadius: 7,
      pointBackgroundColor: '#1d4e89',
      pointBorderColor: '#fff',
      pointBorderWidth: 2,
      tension: 0.25,
      fill: true,
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: '#14171f', padding: 10, cornerRadius: 6,
        titleFont: { size: 12, weight: '600' }, bodyFont: { size: 13 },
        callbacks: { label: function(ctx) { return ctx.raw + ' menciones'; } }
      }
    },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#98a2b3', font: { size: 12 } } },
      y: { beginAtZero: true, grid: { color: '#f0f2f5' }, ticks: { precision: 0, color: '#98a2b3' } }
    }
  }
});

// ── Gráfico 02: composición del conflicto (Chart.js stacked bar) ─────────────
new Chart(document.getElementById('chart-composicion').getContext('2d'), {
  type: 'bar',
  data: {
    labels: {{ semanas_cortas | tojson | safe }},
    datasets: [
      {% for ds in composicion_datasets %}
      {
        label:           {{ ds.label | tojson | safe }},
        data:            {{ ds.data  | tojson | safe }},
        backgroundColor: {{ ds.color | tojson | safe }},
        stack: 'composicion',
        borderRadius: 2,
      },
      {% endfor %}
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'right', labels: { boxWidth: 11, font: { size: 11 }, color: '#475467' } },
      tooltip: { backgroundColor: '#14171f', padding: 10, cornerRadius: 6 },
    },
    scales: {
      x: { stacked: true, grid: { display: false }, ticks: { color: '#98a2b3' } },
      y: { stacked: true, beginAtZero: true, grid: { color: '#f0f2f5' }, ticks: { precision: 0, color: '#98a2b3' } }
    }
  }
});

// ── Vínculo mapa ↔ ranking ↔ tabla: clic en provincia filtra todo lo demás ───
var provinciaSeleccionada = null;
var mapaTooltip = document.getElementById('mapa-tooltip');

function seleccionarProvincia(nombre) {
  provinciaSeleccionada = (provinciaSeleccionada === nombre) ? null : nombre;
  document.querySelectorAll('.provincia-circle').forEach(function(c) {
    c.classList.toggle('selected', c.dataset.nombre === provinciaSeleccionada);
  });
  document.querySelectorAll('.provincia-rank-row').forEach(function(r) {
    r.classList.toggle('activo', r.dataset.nombre === provinciaSeleccionada);
  });
  var chip = document.getElementById('chip-provincia');
  if (provinciaSeleccionada) {
    chip.style.display = 'inline-flex';
    chip.querySelector('span').textContent = provinciaSeleccionada;
  } else {
    chip.style.display = 'none';
  }
  filtrar();
}

function limpiarProvincia() { seleccionarProvincia(null); }

document.querySelectorAll('.provincia-circle').forEach(function(c) {
  c.addEventListener('click', function() { seleccionarProvincia(this.dataset.nombre); });
  c.addEventListener('mousemove', function(e) {
    var sinDatos = this.dataset.sinDatos === 'true';
    var html = '<strong>' + this.dataset.nombre + '</strong><br>';
    html += sinDatos
      ? 'Sin menciones'
      : this.dataset.menciones + ' menciones<br>Dominante: <strong>' + this.dataset.palabra + '</strong>';
    mapaTooltip.innerHTML = html;
    mapaTooltip.style.display = 'block';
    mapaTooltip.style.left = (e.clientX + 14) + 'px';
    mapaTooltip.style.top  = (e.clientY - 10) + 'px';
  });
  c.addEventListener('mouseleave', function() { mapaTooltip.style.display = 'none'; });
});

document.querySelectorAll('.provincia-rank-row').forEach(function(r) {
  r.addEventListener('click', function() { seleccionarProvincia(this.dataset.nombre); });
});

// ── Filtrado de la tabla (vanilla JS) ─────────────────────────────────────────
function filtrar() {
  var corpus  = document.getElementById('f-corpus').value;
  var region  = document.getElementById('f-region').value;
  var palabra = document.getElementById('f-palabra').value;
  var semana  = document.getElementById('f-semana').value;
  var texto   = document.getElementById('f-texto').value.toLowerCase().trim();

  var filas = document.querySelectorAll('#tabla-body tr');
  var visibles = 0;
  filas.forEach(function(tr) {
    var ok = true;
    if (corpus  && tr.dataset.corpus  !== corpus)  ok = false;
    if (region  && tr.dataset.region  !== region)  ok = false;
    if (semana  && tr.dataset.semana  !== semana)  ok = false;
    if (provinciaSeleccionada && tr.dataset.provincia !== provinciaSeleccionada) ok = false;
    if (palabra) {
      var ps = tr.dataset.palabras.split(',').map(function(p){ return p.trim(); });
      if (ps.indexOf(palabra) === -1) ok = false;
    }
    if (texto && tr.dataset.titular.indexOf(texto) === -1) ok = false;
    tr.style.display = ok ? '' : 'none';
    if (ok) visibles++;
  });
  document.getElementById('tabla-count').textContent =
    visibles + ' titular' + (visibles !== 1 ? 'es' : '');
}
</script>

</body>
</html>
