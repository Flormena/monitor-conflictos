<div id="mapa-tooltip"></div>

<script>
// ── Gráfico: tendencia temporal ───────────────────────────────────────────────
new Chart(document.getElementById('chart-tendencia').getContext('2d'), {
  type: 'line',
  data: {
    labels: {{ semanas_cortas | tojson | safe }},
    datasets: [{
      data: {{ total_por_semana | tojson | safe }},
      borderColor: '#4cc9f0',
      backgroundColor: 'rgba(76,201,240,0.08)',
      borderWidth: 2,
      pointRadius: 4,
      pointHoverRadius: 6,
      pointBackgroundColor: '#4cc9f0',
      fill: true,
      tension: 0.25,
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { display: false },
      tooltip: { backgroundColor: '#000', padding: 10, cornerRadius: 2, bodyFont: { family: 'ui-monospace, monospace' } }
    },
    scales: {
      x: { ticks: { color: '#6c7086', font: { family: 'ui-monospace, monospace', size: 11 } }, grid: { color: '#1e2330' } },
      y: { beginAtZero: true, ticks: { color: '#6c7086', font: { family: 'ui-monospace, monospace', size: 10 }, precision: 0 }, grid: { color: '#1e2330' } }
    }
  }
});

// ── Gráfico: menciones por palabra clave ──────────────────────────────────────
new Chart(document.getElementById('chart-palabras').getContext('2d'), {
  type: 'bar',
  data: {
    labels: {{ dist_palabras | map(attribute='palabra') | list | tojson | safe }},
    datasets: [{
      data: {{ dist_palabras | map(attribute='total') | list | tojson | safe }},
      backgroundColor: {{ dist_palabras | map(attribute='color') | list | tojson | safe }},
      borderRadius: 2,
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false }, tooltip: { backgroundColor: '#000', padding: 10, cornerRadius: 2 } },
    scales: {
      x: { ticks: { color: '#cdd6f4', font: { family: 'ui-monospace, monospace', size: 11 } }, grid: { display: false } },
      y: { beginAtZero: true, ticks: { color: '#6c7086', font: { family: 'ui-monospace, monospace', size: 10 }, precision: 0 }, grid: { color: '#1e2330' } }
    }
  }
});

// ── Vínculo mapa ↔ ranking ↔ selector ↔ tabla ─────────────────────────────────
var provinciaSeleccionada = null;
var mapaTooltip = document.getElementById('mapa-tooltip');

function seleccionarProvincia(nombre, desdeSelect) {
  provinciaSeleccionada = (provinciaSeleccionada === nombre || nombre === '') ? null : nombre;
  document.querySelectorAll('.provincia-circle').forEach(function(c) {
    c.classList.toggle('selected', c.dataset.nombre === provinciaSeleccionada);
  });
  document.querySelectorAll('.provincia-rank-row').forEach(function(r) {
    r.classList.toggle('activo', r.dataset.nombre === provinciaSeleccionada);
  });
  if (!desdeSelect) document.getElementById('f-provincia').value = provinciaSeleccionada || '';
  var chip = document.getElementById('chip-provincia');
  if (provinciaSeleccionada) {
    chip.style.display = 'inline-flex';
    chip.querySelector('span').textContent = 'Provincia: ' + provinciaSeleccionada;
  } else {
    chip.style.display = 'none';
  }
  filtrar();
}

function limpiarProvincia() { seleccionarProvincia(null); }

document.querySelectorAll('.provincia-circle').forEach(function(c) {
  c.addEventListener('click', function() { seleccionarProvincia(this.dataset.nombre); });
  c.addEventListener('mousemove', function(e) {
    var sinDatos = this.dataset.sinDatos === 'true';
    var html = '<strong>' + this.dataset.nombre + '</strong><br>';
    html += sinDatos ? 'sin menciones' : this.dataset.menciones + ' menciones<br>dominante: ' + this.dataset.palabra;
    mapaTooltip.innerHTML = html;
    mapaTooltip.style.display = 'block';
    mapaTooltip.style.left = (e.clientX + 14) + 'px';
    mapaTooltip.style.top  = (e.clientY - 10) + 'px';
  });
  c.addEventListener('mouseleave', function() { mapaTooltip.style.display = 'none'; });
});

// ── Filtrado de tabla ──────────────────────────────────────────────────────────
function filtrar() {
  var corpus  = document.getElementById('f-corpus').value;
  var region  = document.getElementById('f-region').value;
  var palabra = document.getElementById('f-palabra').value;
  var semana  = document.getElementById('f-semana').value;
  var texto   = document.getElementById('f-texto').value.toLowerCase().trim();

  var filas = document.querySelectorAll('#tabla-body tr');
  var visibles = 0;
  filas.forEach(function(tr) {
    var ok = true;
    if (corpus  && tr.dataset.corpus  !== corpus)  ok = false;
    if (region  && tr.dataset.region  !== region)  ok = false;
    if (semana  && tr.dataset.semana  !== semana)  ok = false;
    if (provinciaSeleccionada && tr.dataset.provincia !== provinciaSeleccionada) ok = false;
    if (palabra) {
      var ps = tr.dataset.palabras.split(',').map(function(p){ return p.trim(); });
      if (ps.indexOf(palabra) === -1) ok = false;
    }
    if (texto && tr.dataset.titular.indexOf(texto) === -1) ok = false;
    tr.style.display = ok ? '' : 'none';
    if (ok) visibles++;
  });
  document.getElementById('tabla-count').textContent = visibles + ' titular' + (visibles !== 1 ? 'es' : '');
}

function limpiarTodo() {
  ['f-corpus','f-region','f-palabra','f-semana'].forEach(function(id){ document.getElementById(id).value = ''; });
  document.getElementById('f-texto').value = '';
  seleccionarProvincia(null);
}

filtrar();
</script>

</body>
</html>
